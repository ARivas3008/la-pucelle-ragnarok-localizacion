  "changes": [
    {
      "resource": "SP/talk11_jp.dat",
      "offset": 143900,
      "source": "That terrible darkness in his heart is what drew the fallen angel Calamity to him.",
      "before": "Calamidad hacia él.",
      "after": "Calamity hacia él."
    },
    {
      "resource": "SP/talk11_jp.dat",
      "offset": 191501,
      "source": "To summon Calamity, the symbol of darkness, and to take her power for my own!",
      "before": "Calamidad, símbolo",
      "after": "Calamity, símbolo"
    },
    {
      "resource": "SP/talk12_jp.dat",
      "offset": 160671,
      "source": "Master Noir... Why are you waiting to summon Calamity?",
      "before": "invocar a Calamidad?",
      "after": "invocar a Calamity?"
    },
    {
      "resource": "SP/talk12_jp.dat",
      "offset": 166516,
      "source": "So that is how he plans to summon the fallen angel Calamity, hum?",
